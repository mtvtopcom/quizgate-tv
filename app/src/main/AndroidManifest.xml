<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.quizgate.tv"
    android:versionCode="10206"
    android:versionName="1.2.6">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 只用于检查更新与下载新版 APK。请求就是一个裸 GET，不带参数、不传设备信息、不上报任何东西。
         代码里唯一的出网点在 Updater.java，可用 grep -rn "openConnection" 验证只有一处。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 把下载好的 APK 交给系统安装器。仍然需要用户在系统弹窗上按「安装」，无法静默安装。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- v1.2.6 卸载留痕：只写一个自定义系统设置键（首次安装 / 最后心跳 / 卸载次数），
         不改任何系统配置、不含口令或凭据派生值。缺授权时功能自动停用并在设置页红字提示。
         两条 adb 授权任一生效即可：appops WRITE_SETTINGS 或 pm grant WRITE_SECURE_SETTINGS。 -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:label="答对再看"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GateService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parental_screen_time_gate" />
        </service>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- PackageInstaller 的 commit 结果回调。系统作为 PendingIntent 的发送方投递，
             所以 exported="false" 也能收到；不声明的话，「签名不一致」这类失败会静默无提示。 -->
        <receiver android:name=".InstallResultReceiver" android:exported="false" />

        <!-- 存活锚点：系统会把已授权的通知监听重新绑定，从而在强停/开机后把进程拉回来。
             不读通知内容；只作为「复活信号」。这是本机唯一可靠的存活机制。 -->
        <service
            android:name=".NotifProbe"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
